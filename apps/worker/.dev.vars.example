# Copie para .dev.vars (só para "wrangler dev"; nunca vai para o Git nem para a nuvem)
# Mock do Pluggy (node mock/api-mock.mjs). Em produção não existe PLUGGY_API_URL: usa https://api.pluggy.ai.
PLUGGY_API_URL=http://localhost:8788
PLUGGY_CLIENT_ID=id-teste
PLUGGY_CLIENT_SECRET=segredo-teste
PLUGGY_ITEM_IDS=item-inter,item-santander
APP_PASSWORD=teste123
SESSION_SECRET=segredo-local-de-teste
# Push local: permite endpoints http://localhost (o mock em 8788 simula o serviço de push).
PUSH_HTTP_LOCAL=1
# Para testar o envio, gere um par SÓ de teste (não é a chave de produção) e preencha:
#   node scripts/vapid.mjs vapid-local.txt > vapid-local.json
#   VAPID_PUBLICA=<conteúdo de vapid-local.txt>
#   VAPID_PRIVADA=<conteúdo de vapid-local.json em uma linha>
